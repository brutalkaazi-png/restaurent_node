<%
let initialSubtotal = 0;
%>
<div class="card welcome-card" style="margin-bottom:20px;">
  <div>
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px;">
      <span class="badge status-available">● POS Settlement & Cashier Terminal</span>
      <span style="font-size:12px;color:var(--muted);"><%= restaurant.name %></span>
    </div>
    <h2>Table <%= table.table_name %> Guest Checkout</h2>
    <p>Review dine-in items, apply discounts or tax, choose payment tender, and generate ESC/POS thermal receipts.</p>
  </div>
  <a class="btn btn-secondary" href="/counter-admin/<%= restaurant.slug %>/counter">← Return to Floor Counter</a>
</div>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:20px;align-items:start;">
  <!-- LEFT: ORDER ITEMS -->
  <div class="card" style="margin:0;box-shadow:var(--shadow-sm);">
    <div style="display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:12px;margin-bottom:16px;">
      <div>
        <h3 style="margin:0;font-size:17px;color:var(--ink);">Table <%= table.table_name %> Order Items</h3>
        <span style="font-size:12.5px;color:var(--muted);"><%= orders.length %> line items on ticket</span>
      </div>
      <label style="margin:0;font-size:12px;cursor:pointer;display:flex;align-items:center;gap:6px;font-weight:600;color:var(--brand);">
        <input type="checkbox" id="select-all-checkbox" checked style="width:auto;margin:0;"> Select all
      </label>
    </div>

    <table style="width:100%;border-collapse:collapse;margin-bottom:12px;">
      <thead>
        <tr style="border-bottom:2px solid var(--line);text-align:left;font-size:11.5px;text-transform:uppercase;letter-spacing:0.04em;color:var(--muted);">
          <th style="padding:8px 4px;width:28px;"></th>
          <th style="padding:8px 6px;">Qty</th>
          <th style="padding:8px 6px;">Item</th>
          <th style="padding:8px 6px;text-align:right;">Rate</th>
          <th style="padding:8px 6px;text-align:right;">Total</th>
        </tr>
      </thead>
      <tbody>
        <% orders.forEach(function(order) { %>
          <% const itemTotal = order.quantity * parseFloat(order.price); initialSubtotal += itemTotal; %>
          <tr style="border-bottom:1px solid var(--line);font-size:13.5px;" class="bill-row">
            <td style="padding:10px 4px;">
              <input type="checkbox" class="bill-item-checkbox" value="<%= order.id %>" data-price="<%= order.price %>" data-qty="<%= order.quantity %>" checked style="width:auto;margin:0;">
            </td>
            <td style="padding:10px 6px;font-weight:700;"><%= order.quantity %>x</td>
            <td style="padding:10px 6px;">
              <strong style="color:var(--ink);display:block;"><%= order.item ? order.item.item_name : 'Item #' + order.item_id %></strong>
              <% if (order.variant) { %><span style="font-size:12px;color:var(--muted);">(<%= order.variant.name %>)</span><% } %>
              <% if (order.remarks) { %><div style="font-size:11.5px;color:#d97706;">Note: <%= order.remarks %></div><% } %>
            </td>
            <td style="padding:10px 6px;text-align:right;color:var(--muted);">$<%= parseFloat(order.price).toFixed(2) %></td>
            <td style="padding:10px 6px;text-align:right;font-weight:700;color:var(--ink);">$<%= itemTotal.toFixed(2) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- RIGHT: BILL CALCULATION, PAYMENT & PRINTING -->
  <div class="card" style="margin:0;box-shadow:var(--shadow-md);border:1.5px solid var(--line);">
    <div style="border-bottom:1px solid var(--line);padding-bottom:12px;margin-bottom:16px;">
      <div style="display:flex;align-items:center;justify-content:space-between;">
        <h3 style="margin:0;font-size:17px;color:var(--ink);">Settlement Summary</h3>
        <span class="badge status-occupied">● Open Ticket</span>
      </div>
    </div>

    <!-- ADJUSTMENTS: DISCOUNT & TAX -->
    <div style="display:grid;gap:12px;margin-bottom:18px;">
      <div>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
          <label style="margin:0;font-size:13px;font-weight:600;color:var(--ink);">Discount %</label>
          <div style="display:flex;gap:4px;">
            <button type="button" class="btn btn-secondary discount-preset" data-pct="0" style="padding:2px 8px;font-size:11px;">0%</button>
            <button type="button" class="btn btn-secondary discount-preset" data-pct="5" style="padding:2px 8px;font-size:11px;">5%</button>
            <button type="button" class="btn btn-secondary discount-preset" data-pct="10" style="padding:2px 8px;font-size:11px;">10%</button>
            <button type="button" class="btn btn-secondary discount-preset" data-pct="15" style="padding:2px 8px;font-size:11px;">15%</button>
          </div>
        </div>
        <input type="number" id="discount-percent" value="0" min="0" max="100" step="0.5" style="margin:0;padding:8px 12px;text-align:right;font-weight:600;">
      </div>

      <div>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
          <label style="margin:0;font-size:13px;font-weight:600;color:var(--ink);">Sales Tax / VAT %</label>
          <div style="display:flex;gap:4px;">
            <button type="button" class="btn btn-secondary tax-preset" data-pct="0" style="padding:2px 8px;font-size:11px;">0%</button>
            <button type="button" class="btn btn-secondary tax-preset" data-pct="5" style="padding:2px 8px;font-size:11px;">5%</button>
            <button type="button" class="btn btn-secondary tax-preset" data-pct="8.875" style="padding:2px 8px;font-size:11px;">8.88%</button>
            <button type="button" class="btn btn-secondary tax-preset" data-pct="10" style="padding:2px 8px;font-size:11px;">10%</button>
          </div>
        </div>
        <input type="number" id="tax-percent" value="0" min="0" max="100" step="0.1" style="margin:0;padding:8px 12px;text-align:right;font-weight:600;">
      </div>
    </div>

    <!-- LIVE FINANCIAL BREAKDOWN -->
    <div style="background:#f8fafc;padding:14px 16px;border-radius:10px;border:1px solid var(--line);margin-bottom:18px;">
      <div style="display:flex;justify-content:space-between;font-size:13.5px;color:var(--muted);margin-bottom:6px;">
        <span>Item Subtotal</span>
        <span id="display-subtotal">$<%= initialSubtotal.toFixed(2) %></span>
      </div>
      <div style="display:flex;justify-content:space-between;font-size:13.5px;color:#be123c;margin-bottom:6px;">
        <span>Discount</span>
        <span id="display-discount">-$0.00</span>
      </div>
      <div style="display:flex;justify-content:space-between;font-size:13.5px;color:var(--muted);margin-bottom:8px;">
        <span>Tax</span>
        <span id="display-tax">+$0.00</span>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:baseline;border-top:1px dashed var(--line);padding-top:8px;">
        <strong style="font-size:16px;color:var(--ink);">Grand Total Due</strong>
        <strong id="display-grand-total" style="font-size:22px;color:var(--brand);">$<%= initialSubtotal.toFixed(2) %></strong>
      </div>
    </div>

    <!-- PAYMENT TENDER SELECTOR -->
    <div style="margin-bottom:18px;">
      <label style="display:block;font-size:12px;text-transform:uppercase;letter-spacing:0.04em;font-weight:700;color:var(--muted);margin-bottom:8px;">Payment Method</label>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;" id="payment-methods">
        <button type="button" class="btn pay-method-btn active-method" data-method="cash" style="padding:8px 6px;font-size:12.5px;font-weight:700;border:1.5px solid var(--brand);background:#fff7ed;color:#9a3412;">
          💵 Cash
        </button>
        <button type="button" class="btn btn-secondary pay-method-btn" data-method="card" style="padding:8px 6px;font-size:12.5px;font-weight:600;">
          💳 Card
        </button>
        <button type="button" class="btn btn-secondary pay-method-btn" data-method="digital" style="padding:8px 6px;font-size:12.5px;font-weight:600;">
          📱 Digital / QR
        </button>
      </div>
    </div>

    <!-- CASH TENDERED & CHANGE CALCULATOR (SHOWN FOR CASH) -->
    <div id="cash-tender-box" style="background:#fffbeb;padding:12px 14px;border-radius:8px;border:1px solid #fde68a;margin-bottom:18px;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
        <label style="margin:0;font-size:12.5px;font-weight:700;color:#92400e;">Cash Tendered ($)</label>
        <div style="display:flex;gap:4px;">
          <button type="button" class="btn btn-secondary quick-tender" id="tender-exact" style="padding:2px 6px;font-size:11px;">Exact</button>
          <button type="button" class="btn btn-secondary quick-tender" data-amt="20" style="padding:2px 6px;font-size:11px;">$20</button>
          <button type="button" class="btn btn-secondary quick-tender" data-amt="50" style="padding:2px 6px;font-size:11px;">$50</button>
          <button type="button" class="btn btn-secondary quick-tender" data-amt="100" style="padding:2px 6px;font-size:11px;">$100</button>
        </div>
      </div>
      <input type="number" id="cash-tendered-input" placeholder="0.00" step="1" min="0" style="margin:0 0 8px;padding:6px 10px;font-weight:700;text-align:right;">
      <div style="display:flex;justify-content:space-between;font-size:13px;font-weight:700;color:#92400e;border-top:1px dashed #fde68a;padding-top:6px;">
        <span>Change Due:</span>
        <span id="cash-change-due">$0.00</span>
      </div>
    </div>

    <!-- SETTLEMENT ACTION BUTTONS -->
    <div style="display:grid;gap:10px;">
      <button type="button" class="btn" id="print-and-complete-btn" style="padding:12px;font-size:15px;font-weight:700;box-shadow:var(--shadow-brand);display:flex;align-items:center;justify-content:center;gap:8px;">
        <span>🖨️</span> Print Thermal Receipt & Close Table
      </button>
      <button type="button" class="btn btn-secondary" id="complete-only-btn" style="padding:10px;font-size:13.5px;font-weight:600;">
        Settle Table Without Printing
      </button>
    </div>
  </div>
</div>

<!-- HIDDEN PRINT CONTAINER FOR DIRECT THERMAL PRINTING -->
<div id="thermal-print-container" style="display:none;"></div>

<script>
  const tableId = <%= table.id %>;
  const slug = '<%= restaurant.slug %>';

  const selectAllCb = document.getElementById('select-all-checkbox');
  const itemCheckboxes = document.querySelectorAll('.bill-item-checkbox');
  const discountInput = document.getElementById('discount-percent');
  const taxInput = document.getElementById('tax-percent');
  const displaySubtotal = document.getElementById('display-subtotal');
  const displayDiscount = document.getElementById('display-discount');
  const displayTax = document.getElementById('display-tax');
  const displayGrandTotal = document.getElementById('display-grand-total');

  let currentSubtotal = 0;
  let currentGrandTotal = 0;

  function calculateTotals() {
    let sub = 0;
    itemCheckboxes.forEach(cb => {
      if (cb.checked) {
        sub += parseFloat(cb.dataset.price) * parseInt(cb.dataset.qty, 10);
      }
    });

    const discPct = Math.max(0, Math.min(100, parseFloat(discountInput.value) || 0));
    const taxPct = Math.max(0, Math.min(100, parseFloat(taxInput.value) || 0));

    const discAmt = (sub * discPct) / 100;
    const afterDisc = sub - discAmt;
    const taxAmt = (afterDisc * taxPct) / 100;
    const grand = afterDisc + taxAmt;

    currentSubtotal = sub;
    currentGrandTotal = grand;

    displaySubtotal.textContent = '$' + sub.toFixed(2);
    displayDiscount.textContent = '-$' + discAmt.toFixed(2);
    displayTax.textContent = '+$' + taxAmt.toFixed(2);
    displayGrandTotal.textContent = '$' + grand.toFixed(2);

    updateChange();
  }

  selectAllCb.addEventListener('change', () => {
    itemCheckboxes.forEach(cb => cb.checked = selectAllCb.checked);
    calculateTotals();
  });

  itemCheckboxes.forEach(cb => {
    cb.addEventListener('change', calculateTotals);
  });

  discountInput.addEventListener('input', calculateTotals);
  taxInput.addEventListener('input', calculateTotals);

  // Discount presets
  document.querySelectorAll('.discount-preset').forEach(btn => {
    btn.addEventListener('click', () => {
      discountInput.value = btn.dataset.pct;
      calculateTotals();
    });
  });

  // Tax presets
  document.querySelectorAll('.tax-preset').forEach(btn => {
    btn.addEventListener('click', () => {
      taxInput.value = btn.dataset.pct;
      calculateTotals();
    });
  });

  // Payment methods
  let selectedMethod = 'cash';
  const cashBox = document.getElementById('cash-tender-box');
  const tenderInput = document.getElementById('cash-tendered-input');
  const changeDueEl = document.getElementById('cash-change-due');

  document.querySelectorAll('.pay-method-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.pay-method-btn').forEach(b => {
        b.classList.remove('active-method');
        b.style.border = '1px solid var(--line)';
        b.style.background = '#fff';
        b.style.color = 'var(--ink-secondary)';
      });
      btn.classList.add('active-method');
      btn.style.border = '1.5px solid var(--brand)';
      btn.style.background = '#fff7ed';
      btn.style.color = '#9a3412';
      selectedMethod = btn.dataset.method;

      if (selectedMethod === 'cash') {
        cashBox.style.display = 'block';
      } else {
        cashBox.style.display = 'none';
      }
    });
  });

  function updateChange() {
    const tendered = parseFloat(tenderInput.value) || 0;
    const change = Math.max(0, tendered - currentGrandTotal);
    changeDueEl.textContent = '$' + change.toFixed(2);
  }

  tenderInput.addEventListener('input', updateChange);
  document.getElementById('tender-exact').addEventListener('click', () => {
    tenderInput.value = currentGrandTotal.toFixed(2);
    updateChange();
  });
  document.querySelectorAll('.quick-tender[data-amt]').forEach(btn => {
    btn.addEventListener('click', () => {
      tenderInput.value = btn.dataset.amt;
      updateChange();
    });
  });

  // Settlement submission
  function submitSettlement(printReceipt) {
    const checked = Array.from(document.querySelectorAll('.bill-item-checkbox:checked')).map(cb => cb.value);
    if (!checked.length) {
      alert('Please select at least one item to bill.');
      return;
    }

    const payload = {
      item_ids: checked,
      discount_percent: discountInput.value,
      tax_percent: taxInput.value,
      print: printReceipt,
    };

    const submitBtn = printReceipt ? document.getElementById('print-and-complete-btn') : document.getElementById('complete-only-btn');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Processing Settlement...';

    fetch(`/counter-admin/complete_order/${tableId}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    })
      .then(r => r.json())
      .then(data => {
        if (data.error) {
          alert(data.error);
          submitBtn.disabled = false;
          return;
        }

        if (printReceipt && data.print_html) {
          const printWindow = window.open('', '_blank', 'width=380,height=600');
          if (printWindow) {
            printWindow.document.write(data.print_html);
            printWindow.document.close();
            printWindow.focus();
            setTimeout(() => {
              printWindow.print();
              printWindow.close();
              window.location = '/counter-admin/' + slug + '/counter';
            }, 500);
          } else {
            // If popup blocked, print via invisible iframe or redirect
            window.location = '/counter-admin/' + slug + '/counter';
          }
        } else {
          window.location = '/counter-admin/' + slug + '/counter';
        }
      })
      .catch(() => {
        submitBtn.disabled = false;
        alert('Network error while completing order.');
      });
  }

  document.getElementById('print-and-complete-btn').addEventListener('click', () => submitSettlement(true));
  document.getElementById('complete-only-btn').addEventListener('click', () => submitSettlement(false));

  calculateTotals();
</script>

