<%
let subtotal = 0;
%>
<div class="card welcome-card" style="margin-bottom:20px;">
  <div>
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px;">
      <span class="badge status-available">● Bill Settlement & Checkout</span>
      <span style="font-size:12px;color:var(--muted);"><%= restaurant.name %></span>
    </div>
    <h2>Table <%= table.table_name %> Bill</h2>
    <p>Select items to include on this guest check, configure discount or tax, and complete settlement.</p>
  </div>
  <a class="btn btn-secondary" href="/counter-admin/<%= restaurant.slug %>/counter">← Back to Counter</a>
</div>

<div class="card" style="max-width:760px;margin:0 auto;box-shadow:var(--shadow-md);">
  <div style="display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:12px;margin-bottom:16px;">
    <div>
      <h3 style="margin:0;font-size:17px;"><%= restaurant.name %></h3>
      <span style="font-size:13px;color:var(--muted);">Table: <%= table.table_name %> &middot; <%= new Date().toLocaleDateString() %></span>
    </div>
    <span class="badge status-occupied">Open Bill</span>
  </div>

  <table style="width:100%;border-collapse:collapse;margin-bottom:20px;">
    <thead>
      <tr style="border-bottom:2px solid var(--line);text-align:left;font-size:12px;text-transform:uppercase;letter-spacing:0.04em;color:var(--muted);">
        <th style="padding:8px 6px;width:32px;"></th>
        <th style="padding:8px 6px;">Qty</th>
        <th style="padding:8px 6px;">Item Description</th>
        <th style="padding:8px 6px;text-align:right;">Rate</th>
        <th style="padding:8px 6px;text-align:right;">Total</th>
      </tr>
    </thead>
    <tbody>
      <% orders.forEach(function(order) { %>
        <% const itemTotal = order.quantity * parseFloat(order.price); subtotal += itemTotal; %>
        <tr style="border-bottom:1px solid var(--line);font-size:14px;">
          <td style="padding:10px 6px;"><input type="checkbox" class="bill-item-checkbox" value="<%= order.id %>" checked style="width:auto;margin:0;"></td>
          <td style="padding:10px 6px;font-weight:600;"><%= order.quantity %>x</td>
          <td style="padding:10px 6px;">
            <strong style="color:var(--ink);"><%= order.item ? order.item.item_name : 'N/A' %></strong>
            <% if (order.variant) { %><span style="font-size:12.5px;color:var(--muted);"> (<%= order.variant.name %>)</span><% } %>
          </td>
          <td style="padding:10px 6px;text-align:right;color:var(--muted);">$<%= parseFloat(order.price).toFixed(2) %></td>
          <td style="padding:10px 6px;text-align:right;font-weight:600;color:var(--ink);">$<%= itemTotal.toFixed(2) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <div style="background:#f8fafc;padding:16px 20px;border-radius:10px;border:1px solid var(--line);margin-bottom:20px;">
    <div class="item-row" style="margin-bottom:10px;">
      <label style="margin:0;font-size:13.5px;color:var(--ink);">Discount %</label>
      <input type="number" id="discount-percent" value="0" min="0" max="100" style="width:100px;margin:0;padding:6px 10px;text-align:right;">
    </div>
    <div class="item-row" style="margin-bottom:12px;">
      <label style="margin:0;font-size:13.5px;color:var(--ink);">Tax %</label>
      <input type="number" id="tax-percent" value="0" min="0" max="100" style="width:100px;margin:0;padding:6px 10px;text-align:right;">
    </div>
    <div class="item-row" style="border-top:1px solid var(--line);padding-top:12px;">
      <strong style="font-size:16px;color:var(--ink);">Subtotal Amount</strong>
      <strong id="subtotal" style="font-size:18px;color:var(--brand);">$<%= subtotal.toFixed(2) %></strong>
    </div>
  </div>

  <button type="button" class="btn" id="complete-order-btn" style="width:100%;padding:14px;font-size:15px;box-shadow:var(--shadow-brand);">Complete Settlement & Close Table ↗</button>
</div>

<script>
  const tableId = <%= table.id %>;
  document.getElementById('complete-order-btn').addEventListener('click', () => {
    const itemIds = Array.from(document.querySelectorAll('.bill-item-checkbox:checked')).map(cb => cb.value);
    fetch(`/counter-admin/complete_order/${tableId}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        item_ids: itemIds,
        discount_percent: document.getElementById('discount-percent').value,
        tax_percent: document.getElementById('tax-percent').value,
      }),
    }).then(r => r.json()).then(data => {
      if (data.success) window.location = '/counter-admin/' + '<%= restaurant.slug %>' + '/counter';
    });
  });
</script>
