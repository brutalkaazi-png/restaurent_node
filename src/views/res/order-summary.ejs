<div class="card">
  <h2>Order summary</h2>
  <% if (subscriptionName) { %><p>Plan: <%= subscriptionName %></p><% } %>
  <form method="GET" action="/order-summary">
    <label>Period</label>
    <select name="date_period">
      <option value="">All time</option>
      <option value="daily" <%= datePeriod === 'daily' ? 'selected' : '' %>>Daily</option>
      <option value="monthly" <%= datePeriod === 'monthly' ? 'selected' : '' %>>Monthly</option>
      <option value="yearly" <%= datePeriod === 'yearly' ? 'selected' : '' %>>Yearly</option>
      <option value="custom" <%= datePeriod === 'custom' ? 'selected' : '' %>>Custom (from|to)</option>
    </select>
    <label>Date</label>
    <input type="text" name="selected_date" value="<%= dateRange %>">
    <button class="btn" type="submit">Apply</button>
  </form>
</div>

<div class="card">
  <div class="item-row"><strong>Total orders</strong><strong><%= totalCount %></strong></div>
  <div class="item-row"><strong>Total sales</strong><strong><%= parseFloat(totalSales).toFixed(2) %></strong></div>
</div>

<div class="card">
  <h3>Online orders</h3>
  <div class="item-row"><span>Count</span><span><%= singleqrCount %></span></div>
  <div class="item-row"><span>Sales</span><span><%= parseFloat(totalSingleqrSales).toFixed(2) %></span></div>
</div>

<div class="card">
  <h3>Table orders</h3>
  <div class="item-row"><span>Count</span><span><%= tableqrCount %></span></div>
  <div class="item-row"><span>Sales</span><span><%= parseFloat(totalTableqrSales).toFixed(2) %></span></div>
</div>
