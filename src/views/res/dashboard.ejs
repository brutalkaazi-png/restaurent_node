<div class="card welcome-card">
  <div>
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
      <span class="badge status-available" style="font-size:11px;">● Service Active</span>
      <span style="font-size:12px;color:var(--muted);"><%= currentUser.slug ? '/' + currentUser.slug : '' %></span>
    </div>
    <h2>Good to see you, <%= currentUser.name %>.</h2>
    <p>Everything you need to monitor sales, floor status, and kitchen throughput today.</p>
  </div>
  <div style="display:flex;gap:10px;flex-wrap:wrap;">
    <% if (currentUser.slug) { %>
      <a class="btn btn-secondary" href="/<%= currentUser.slug %>/menu" target="_blank" rel="noopener">Preview Menu ↗</a>
    <% } %>
    <a class="btn" href="/menus/create">+ Add menu item</a>
  </div>
</div>

<div style="margin:24px 0 12px;display:flex;align-items:center;justify-content:space-between;">
  <h3 style="margin:0;font-size:16px;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted);">Service Metrics</h3>
  <span style="font-size:12px;color:var(--subtle);">Live updates</span>
</div>

<section class="quick-grid" aria-label="Restaurant summary">
  <div class="quick-link">
    <span class="quick-icon" style="background:#ecfdf5;color:#059669;">$</span>
    <strong style="font-size:22px;color:var(--ink);">$<%= stats.sales.toFixed(2) %></strong>
    <span><%= stats.completedOrders %> completed order<%= stats.completedOrders === 1 ? '' : 's' %></span>
  </div>
  <div class="quick-link">
    <span class="quick-icon" style="background:#eff6ff;color:#2563eb;">◷</span>
    <strong style="font-size:22px;color:var(--ink);">$<%= stats.averageTicket.toFixed(2) %></strong>
    <span>Average ticket size</span>
  </div>
  <div class="quick-link">
    <span class="quick-icon" style="background:#fef3c7;color:#d97706;">▦</span>
    <strong style="font-size:22px;color:var(--ink);"><%= stats.activeTables %></strong>
    <span>Active table<%= stats.activeTables === 1 ? '' : 's' %> on floor</span>
  </div>
  <div class="quick-link">
    <span class="quick-icon" style="background:#f1f5f9;color:#475569;">☷</span>
    <strong style="font-size:22px;color:var(--ink);"><%= stats.menuCount %></strong>
    <span><%= stats.soldOutCount > 0 ? stats.soldOutCount + ' sold out' : 'All available' %></span>
  </div>
  <div class="quick-link">
    <span class="quick-icon" style="background:#fff1f2;color:#e11d48;">♨</span>
    <strong style="font-size:22px;color:var(--ink);"><%= stats.kitchenQueue %></strong>
    <span>Orders in prep queue</span>
  </div>
</section>

<div style="margin:28px 0 12px;">
  <h3 style="margin:0;font-size:16px;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted);">Operations & Workspaces</h3>
</div>

<section class="quick-grid" aria-label="Quick actions">
  <a class="quick-link" href="/counter-admin/<%= currentUser.slug %>/counter">
    <span class="quick-icon" style="background:var(--brand-soft);color:var(--brand);">▣</span>
    <strong>Counter & Billing</strong>
    <span>Live floor plan, guest tabs, and checkout.</span>
  </a>
  <a class="quick-link" href="/kitchen-admin/kitchen">
    <span class="quick-icon" style="background:#fff1f2;color:#e11d48;">♨</span>
    <strong>Kitchen KDS</strong>
    <span>Active cook tickets, timers, and fulfillment.</span>
  </a>
  <a class="quick-link" href="/menus">
    <span class="quick-icon" style="background:#f1f5f9;color:#334155;">☷</span>
    <strong>Menu & Dishes</strong>
    <span>Manage items, variants, and 86 sold-out items.</span>
  </a>
  <a class="quick-link" href="/categories">
    <span class="quick-icon" style="background:#f1f5f9;color:#334155;">◫</span>
    <strong>Categories</strong>
    <span>Organize menu courses and displays.</span>
  </a>
  <a class="quick-link" href="/tables">
    <span class="quick-icon" style="background:#f1f5f9;color:#334155;">▦</span>
    <strong>Table Setup</strong>
    <span>QR codes, table names, and seating zones.</span>
  </a>
  <a class="quick-link" href="/staff-calls">
    <span class="quick-icon" style="background:#ecfdf5;color:#059669;">♧</span>
    <strong>Staff Calls</strong>
    <span>Live guest calls for service, water, or bill.</span>
  </a>
  <a class="quick-link" href="/inventory">
    <span class="quick-icon" style="background:#eff6ff;color:#2563eb;">◈</span>
    <strong>Inventory</strong>
    <span>Stock levels, ingredients, and replenishment.</span>
  </a>
  <a class="quick-link" href="/order-summary">
    <span class="quick-icon" style="background:#fef3c7;color:#d97706;">▤</span>
    <strong>Sales Reports</strong>
    <span>Daily, monthly, and dine-in vs online metrics.</span>
  </a>
  <a class="quick-link" href="/reservations">
    <span class="quick-icon" style="background:#fdf2f8;color:#be185d;">📅</span>
    <strong>Reservations</strong>
    <span>Bookings, party sizes, and table seating.</span>
  </a>
  <a class="quick-link" href="/customers">
    <span class="quick-icon" style="background:#f1f5f9;color:#334155;">♙</span>
    <strong>Customers</strong>
    <span>Guest profiles, order history, and preferences.</span>
  </a>
</section>

