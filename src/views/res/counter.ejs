<div class="card welcome-card" style="margin-bottom:20px;">
  <div>
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px;">
      <span class="badge status-available">● Counter & POS Terminal</span>
      <span style="font-size:12px;color:var(--muted);"><%= restaurant.name %></span>
    </div>
    <h2>Live Floor & Billing</h2>
    <p>Select any active dining table to review orders, print guest check, or process settlement.</p>
  </div>
  <div style="display:flex;gap:10px;flex-wrap:wrap;">
    <a class="btn btn-secondary" href="/kitchen-admin/kitchen" target="_blank">Open KDS ↗</a>
    <a class="btn btn-secondary" href="/staff-calls">Staff Calls</a>
  </div>
</div>

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
  <h3 style="margin:0;font-size:16px;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted);">Dining Tables (<%= tables.length %>)</h3>
  <span style="font-size:12px;color:var(--subtle);">Real-time socket synchronized</span>
</div>

<div id="table-grid">
  <% if (!tables.length) { %>
    <div class="card counter-empty" role="status" style="grid-column:1/-1;padding:48px 20px;text-align:center;">
      <div style="font-size:32px;margin-bottom:8px;">▦</div>
      <h3 style="margin:0 0 6px;">No tables configured</h3>
      <p style="color:var(--muted);margin:0 0 16px;">Set up dining tables and generate QR codes in Table Setup.</p>
      <a class="btn" href="/tables/create">+ Add First Table</a>
    </div>
  <% } %>
  <% tables.forEach(function(table) { %>
    <div class="card table-card" data-table-id="<%= table.id %>" data-status="<%= table.status %>">
      <div class="item-row" style="margin-bottom:10px;">
        <div>
          <strong style="font-size:17px;display:block;"><%= table.table_name %></strong>
          <span style="font-size:12px;color:var(--muted);">Table #<%= table.id %></span>
        </div>
        <span class="item-status table-status badge <%= table.status === 'available' ? 'status-available' : 'status-occupied' %>"><%= table.status.replaceAll('_', ' ') %></span>
      </div>
      <div class="table-elapsed" data-start-time style="font-size:12.5px;color:var(--muted);margin-bottom:14px;">
        <%= table.status === 'available' ? 'Ready for guests' : 'Active dining' %>
      </div>
      <button type="button" class="btn view-table-btn" data-table-id="<%= table.id %>" style="width:100%;">View orders</button>
    </div>
  <% }) %>
</div>

<div id="table-orders-panel" style="margin-top:24px;"></div>

<script src="/socket.io/socket.io.js"></script>
<script>
  const restaurantId = <%= restaurant.id %>;

  function refreshTables() {
    fetch(`/counter-admin/get_table_updates/${restaurantId}`)
      .then(r => { if (!r.ok) throw new Error('Table status request failed'); return r.json(); })
      .then(data => {
        data.tables.forEach(t => {
          const card = document.querySelector(`.table-card[data-table-id="${t.id}"]`);
          if (!card) return;
          card.dataset.status = t.status;
          const status = card.querySelector('.table-status');
          if (status) status.textContent = t.status.replaceAll('_', ' ');
          const elapsed = card.querySelector('[data-start-time]');
          if (elapsed) elapsed.textContent = t.start_time ? `Open since ${new Date(t.start_time).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}` : 'Ready for guests';
        });
      })
      .catch(() => {});
  }

  // Fallback poll in case the socket connection drops - live updates below
  // make this rarely necessary, but it's cheap insurance.
  setInterval(refreshTables, 30000);

  const socket = io();
  socket.emit('join-restaurant', restaurantId);
  socket.on('restaurant-update', () => {
    refreshTables();
    // Also refresh whichever table's order panel is currently open, and
    // the online-orders panel if it's open, so a live status change or a
    // new order shows up without the staff member re-clicking anything.
    const openPanel = document.getElementById('table-orders-panel');
    const openTableId = openPanel && openPanel.dataset.tableId;
    if (openTableId) {
      fetch(`/counter-admin/get_table_orders/${openTableId}`).then(r => r.text()).then(html => { openPanel.innerHTML = html; });
    }
  });

  document.querySelectorAll('.view-table-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      fetch(`/counter-admin/get_table_orders/${btn.dataset.tableId}`)
        .then(r => r.text())
        .then(html => {
          const panel = document.getElementById('table-orders-panel');
          panel.innerHTML = html;
          panel.dataset.tableId = btn.dataset.tableId;
        });
    });
  });
</script>
