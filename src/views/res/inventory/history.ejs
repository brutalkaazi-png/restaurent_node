<div class="card welcome-card" style="margin-bottom:20px;">
  <div>
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px;">
      <span class="badge status-available">● Audit Trail</span>
      <span style="font-size:12px;color:var(--muted);">Item #<%= item.id %></span>
    </div>
    <h2>Stock History: <%= item.name %></h2>
    <p>Current stock balance: <strong style="color:var(--brand);font-size:16px;"><%= item.quantity %> <%= item.unit %></strong></p>
  </div>
  <div style="display:flex;gap:8px;flex-wrap:wrap;">
    <a class="btn" href="/inventory/<%= item.id %>/stock-in" style="background:#16a34a;border-color:#16a34a;">+ Stock In</a>
    <a class="btn btn-secondary" href="/inventory/<%= item.id %>/stock-out">- Stock Out</a>
    <a class="btn btn-secondary" href="/inventory">← Back to Inventory</a>
  </div>
</div>

<div class="card" style="box-shadow:var(--shadow-sm);border:1px solid var(--line);">
  <h3 style="margin:0 0 16px;font-size:16px;color:var(--ink);">Historical Inbound & Outbound Log</h3>

  <% if (!transactions.length) { %>
    <p style="text-align:center;color:var(--muted);padding:36px 0;margin:0;">No transactions recorded for this item yet.</p>
  <% } else { %>
    <div style="display:grid;gap:10px;">
      <% transactions.forEach(function(t) { 
        const isIn = t.type === 'in';
      %>
        <div class="item-row" style="background:#f8fafc;padding:12px 16px;border-radius:8px;border:1px solid var(--line);">
          <div style="display:flex;align-items:center;gap:12px;">
            <div style="width:36px;height:36px;border-radius:8px;background:<%= isIn ? '#dcfce7' : '#fee2e2' %>;color:<%= isIn ? '#15803d' : '#b91c1c' %>;display:grid;place-items:center;font-size:16px;font-weight:700;">
              <%= isIn ? '↓' : '↑' %>
            </div>
            <div>
              <div style="display:flex;align-items:center;gap:8px;">
                <strong style="color:var(--ink);"><%= isIn ? 'Stock Inbound Delivery' : 'Stock Consumption / Out' %></strong>
                <span class="badge" style="font-size:11px;background:<%= isIn ? '#dcfce7' : '#fee2e2' %>;color:<%= isIn ? '#166534' : '#991b1b' %>;">
                  <%= isIn ? '+' : '-' %><%= t.quantity %> <%= item.unit %>
                </span>
              </div>
              <div style="font-size:12px;color:var(--muted);margin-top:2px;">
                <%= new Date(t.created_at).toLocaleString() %>
                <% if (t.notes) { %> &middot; <em>"<%= t.notes %>"</em><% } %>
              </div>
            </div>
          </div>

          <div style="text-align:right;">
            <% if (t.price_per_unit) { %>
              <span style="font-size:12.5px;color:var(--muted);">Unit Cost: <strong>$<%= parseFloat(t.price_per_unit).toFixed(2) %></strong></span>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<% if (totalPages > 1) { %>
  <div class="card" style="display:flex;justify-content:center;gap:6px;margin-top:20px;">
    <% for (let p = 1; p <= totalPages; p++) { %>
      <a class="btn <%= p === page ? '' : 'btn-secondary' %>" href="?page=<%= p %>" style="min-width:36px;text-align:center;padding:6px 12px;"><%= p %></a>
    <% } %>
  </div>
<% } %>

