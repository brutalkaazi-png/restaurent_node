<%
let totalIn = 0;
let totalOut = 0;
let totalClosing = 0;
reportData.forEach(row => {
  totalIn += parseFloat(row.stock_in) || 0;
  totalOut += parseFloat(row.stock_out) || 0;
  totalClosing += parseFloat(row.closing_stock) || 0;
});
%>

<div class="card welcome-card" style="margin-bottom:20px;">
  <div>
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px;">
      <span class="badge status-available">● Audit Report</span>
      <span style="font-size:12px;color:var(--muted);"><%= (datePeriod || 'Daily').toUpperCase() %> MOVEMENT</span>
    </div>
    <h2>Stock Movement & Depletion Report</h2>
    <p>Audit opening stock, vendor intake deliveries, kitchen deductions, and ending inventory balances.</p>
  </div>
  <div style="display:flex;gap:8px;flex-wrap:wrap;">
    <button type="button" class="btn" onclick="window.print()" style="display:flex;align-items:center;gap:6px;">
      <span>🖨️</span> Print Stock Sheet
    </button>
    <a class="btn btn-secondary" href="/inventory">← Back to Inventory</a>
  </div>
</div>

<!-- 3 AUDIT KPI TILES -->
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-bottom:20px;">
  <div class="card" style="margin:0;border:1px solid var(--line);">
    <span style="font-size:12px;text-transform:uppercase;letter-spacing:0.04em;color:var(--muted);font-weight:700;">Items in Audit</span>
    <div style="font-size:26px;font-weight:800;color:var(--ink);margin:6px 0 2px;"><%= reportData.length %></div>
    <span style="font-size:12px;color:var(--muted);">Total tracked ingredients</span>
  </div>

  <div class="card" style="margin:0;border:1px solid var(--line);">
    <span style="font-size:12px;text-transform:uppercase;letter-spacing:0.04em;color:var(--muted);font-weight:700;">Stock Received (+)</span>
    <div style="font-size:26px;font-weight:800;color:#16a34a;margin:6px 0 2px;">+<%= totalIn.toFixed(1) %></div>
    <span style="font-size:12px;color:var(--muted);">Inbound purchase additions</span>
  </div>

  <div class="card" style="margin:0;border:1px solid var(--line);">
    <span style="font-size:12px;text-transform:uppercase;letter-spacing:0.04em;color:var(--muted);font-weight:700;">Stock Used / Depleted (-)</span>
    <div style="font-size:26px;font-weight:800;color:#dc2626;margin:6px 0 2px;">-<%= totalOut.toFixed(1) %></div>
    <span style="font-size:12px;color:var(--muted);">Kitchen consumption & waste</span>
  </div>
</div>

<!-- PERIOD FILTER -->
<div class="card" style="margin-bottom:20px;padding:16px 20px;">
  <form method="GET" action="/inventory-report" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr)) auto;gap:12px;align-items:end;margin:0;">
    <div>
      <label style="margin:0 0 4px;font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;">Audit Period</label>
      <select name="date_period" style="margin:0;padding:8px 12px;border-radius:8px;">
        <option value="daily" <%= datePeriod === 'daily' ? 'selected' : '' %>>Daily</option>
        <option value="weekly" <%= datePeriod === 'weekly' ? 'selected' : '' %>>Weekly</option>
        <option value="monthly" <%= datePeriod === 'monthly' ? 'selected' : '' %>>Monthly</option>
        <option value="yearly" <%= datePeriod === 'yearly' ? 'selected' : '' %>>Yearly</option>
        <option value="custom" <%= datePeriod === 'custom' ? 'selected' : '' %>>Custom Range</option>
      </select>
    </div>
    <div>
      <label style="margin:0 0 4px;font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;">Date / Range (e.g. YYYY-MM-DD)</label>
      <input type="text" name="selected_date" value="<%= dateRange || '' %>" placeholder="YYYY-MM-DD" style="margin:0;padding:8px 12px;border-radius:8px;">
    </div>
    <div>
      <button class="btn" type="submit" style="padding:9px 18px;margin:0;width:100%;">Filter Audit</button>
    </div>
  </form>
</div>

<!-- MOVEMENT AUDIT TABLE -->
<div class="card" style="box-shadow:var(--shadow-sm);border:1px solid var(--line);overflow-x:auto;">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">
    <h3 style="margin:0;font-size:16px;color:var(--ink);">Detailed Inventory Ledger</h3>
    <span style="font-size:12px;color:var(--muted);"><%= reportData.length %> entries</span>
  </div>

  <% if (!reportData.length) { %>
    <p style="text-align:center;color:var(--muted);padding:32px 0;margin:0;">No inventory activity found for this period.</p>
  <% } else { %>
    <table style="width:100%;border-collapse:collapse;">
      <thead>
        <tr style="border-bottom:2px solid var(--line);text-align:left;font-size:11.5px;text-transform:uppercase;letter-spacing:0.04em;color:var(--muted);">
          <th style="padding:10px 8px;">Ingredient / Item</th>
          <th style="padding:10px 8px;text-align:right;">Opening</th>
          <th style="padding:10px 8px;text-align:right;color:#16a34a;">+ Inbound</th>
          <th style="padding:10px 8px;text-align:right;color:#dc2626;">- Deductions</th>
          <th style="padding:10px 8px;text-align:right;">Closing Balance</th>
          <th style="padding:10px 8px;text-align:center;">Action</th>
        </tr>
      </thead>
      <tbody>
        <% reportData.forEach(function(row) { 
          const closing = parseFloat(row.closing_stock) || 0;
          const isLow = closing <= 10;
        %>
          <tr style="border-bottom:1px solid var(--line);font-size:13.5px;">
            <td style="padding:10px 8px;">
              <strong style="color:var(--ink);display:block;"><%= row.name %></strong>
              <span style="font-size:11.5px;color:var(--muted);">Unit: <%= row.unit %></span>
            </td>
            <td style="padding:10px 8px;text-align:right;color:var(--muted);"><%= row.opening_stock %></td>
            <td style="padding:10px 8px;text-align:right;font-weight:700;color:#16a34a;">
              <%= parseFloat(row.stock_in) > 0 ? '+' + row.stock_in : '-' %>
            </td>
            <td style="padding:10px 8px;text-align:right;font-weight:700;color:#dc2626;">
              <%= parseFloat(row.stock_out) > 0 ? '-' + row.stock_out : '-' %>
            </td>
            <td style="padding:10px 8px;text-align:right;">
              <strong style="font-size:14px;color:<%= isLow ? '#ea580c' : 'var(--ink)' %>;"><%= row.closing_stock %></strong>
              <% if (isLow) { %>
                <span class="badge" style="background:#ffedd5;color:#9a3412;font-size:10px;margin-left:4px;">Low</span>
              <% } %>
            </td>
            <td style="padding:10px 8px;text-align:center;">
              <a href="/inventory/<%= row.id %>/stock-in" class="btn btn-secondary" style="padding:4px 8px;font-size:11.5px;">+ Stock In</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

