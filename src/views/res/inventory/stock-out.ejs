<div class="card">
  <h2>Stock out: <%= item.name %></h2>
  <p>Current: <%= item.quantity %> <%= item.unit %></p>
  <% if (errors && errors.length) { %>
    <div class="message"><% errors.forEach(function(e) { %><div><%= e %></div><% }) %></div>
  <% } %>
  <form method="POST" action="/inventory/<%= item.id %>/stock-out">
    <label>Quantity to remove (<%= item.unit %>)</label>
    <input type="number" step="0.01" min="0.01" max="<%= item.quantity %>" name="quantity" required>
    <label>Notes (required - why is stock being removed?)</label>
    <input type="text" name="notes" required>
    <button class="btn" type="submit">Remove stock</button>
    <a class="btn btn-secondary" href="/inventory">Cancel</a>
  </form>
</div>
