<div class="card"><h2>Edit customer</h2><form method="POST" action="/customers/<%= customer.id %>"><label>Name</label><input name="name" required value="<%= customer.name %>"><label>Phone</label><input name="phone" value="<%= customer.phone || '' %>"><label>Email</label><input type="email" name="email" value="<%= customer.email || '' %>"><label>Address</label><input name="address" value="<%= customer.address || '' %>"><label>Notes</label><textarea name="notes"><%= customer.notes || '' %></textarea><button class="btn" type="submit">Save</button><a class="btn btn-secondary" href="/customers">Cancel</a></form></div>
