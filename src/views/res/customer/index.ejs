<div class="card"><div class="item-row"><div><h2>Customers</h2><p>Restaurant-scoped customer profiles and visit history.</p></div><form method="GET" action="/customers"><input aria-label="Search customers" name="search" placeholder="Search name, email, phone" value="<%= search %>"><button class="btn btn-secondary" type="submit">Search</button></form></div></div>
<% if (!customers.length) { %><div class="card" role="status">No customers found.</div><% } %>
<% customers.forEach((customer) => { %><div class="card"><div class="item-row"><div><strong><%= customer.name %></strong><div><%= customer.phone || customer.email || 'No contact details' %></div><small><%= customer.notes || 'No notes' %></small></div><div><strong><%= customer.visit_count %> visits</strong><br><span>$<%= parseFloat(customer.total_spend || 0).toFixed(2) %> spent</span><br><a class="btn btn-secondary" href="/customers/<%= customer.id %>/history">History</a> <a class="btn" href="/customers/<%= customer.id %>/edit">Edit</a></div></div></div><% }) %>
