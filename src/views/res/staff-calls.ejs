<%
const pendingList = (typeof calls !== 'undefined' && calls) ? calls : [];
const resolvedList = (typeof resolvedCalls !== 'undefined' && resolvedCalls) ? resolvedCalls : [];

function getCallMeta(type) {
  switch(type) {
    case 'water':
      return { label: 'Water Refill', icon: '💧', bg: '#eff6ff', color: '#1e40af', border: '#bfdbfe' };
    case 'bill':
      return { label: 'Bill / Check', icon: '💳', bg: '#ecfdf5', color: '#065f46', border: '#a7f3d0' };
    case 'cutlery':
      return { label: 'Cutlery / Napkins', icon: '🍴', bg: '#fdf4ff', color: '#86198f', border: '#f5d0fe' };
    case 'clean':
      return { label: 'Table Cleaning', icon: '🧹', bg: '#fffbeb', color: '#92400e', border: '#fde68a' };
    default:
      return { label: 'General Assistance', icon: '🛎️', bg: '#fff7ed', color: '#9a3412', border: '#fed7aa' };
  }
}
%>

<!-- TOAST ALERT NOTIFICATION -->
<div id="call-toast" style="display:none;position:fixed;top:20px;right:20px;z-index:99999;padding:12px 20px;border-radius:10px;box-shadow:var(--shadow-xl);font-size:13.5px;font-weight:700;align-items:center;gap:10px;">
  <span id="toast-icon">✓</span>
  <span id="toast-text"></span>
</div>

<!-- HEADER WORKSPACE -->
<section class="card welcome-card" style="margin-bottom:16px;">
  <div>
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px;">
      <span class="badge status-available">● Floor Service Dispatch</span>
      <span style="font-size:12px;color:var(--muted);">Live Customer Calls</span>
    </div>
    <h2 style="margin:0 0 4px;font-size:24px;">Floor Assistance & Service Bell</h2>
    <p style="margin:0;color:var(--muted);font-size:13.5px;">Real-time assistance, drink refills, and bill requests transmitted from guest table QR menus.</p>
  </div>
  
  <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
    <!-- AUDIO TOGGLE -->
    <button type="button" id="toggle-call-sound" class="btn btn-secondary" style="display:inline-flex;align-items:center;gap:6px;font-size:13px;">
      <span id="call-sound-icon">🔔</span> <span id="call-sound-label">Audio: ON</span>
    </button>
    <span class="badge status-occupied" id="pending-count-badge" style="font-size:13px;padding:8px 16px;font-weight:800;">
      <%= pendingList.length %> Active Call<%= pendingList.length === 1 ? '' : 's' %>
    </span>
  </div>
</section>

<!-- KPI METRIC TILES -->
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-bottom:16px;">
  <div class="card" style="margin:0;padding:14px 18px;border:1px solid var(--line);">
    <span style="font-size:11px;text-transform:uppercase;letter-spacing:0.04em;color:var(--muted);font-weight:700;">Waiting Assistance</span>
    <div id="kpi-pending-count" style="font-size:26px;font-weight:800;color:<%= pendingList.length > 0 ? '#ea580c' : 'var(--ink)' %>;margin:4px 0 2px;">
      <%= pendingList.length %>
    </div>
    <span style="font-size:11.5px;color:var(--muted);"><%= pendingList.length > 0 ? 'Requires immediate attention' : 'All tables served' %></span>
  </div>

  <div class="card" style="margin:0;padding:14px 18px;border:1px solid var(--line);">
    <span style="font-size:11px;text-transform:uppercase;letter-spacing:0.04em;color:var(--muted);font-weight:700;">Bill Requests</span>
    <div style="font-size:26px;font-weight:800;color:#0d9488;margin:4px 0 2px;">
      <%= pendingList.filter(c => c.type === 'bill').length %>
    </div>
    <span style="font-size:11.5px;color:var(--muted);">Ready for checkout</span>
  </div>

  <div class="card" style="margin:0;padding:14px 18px;border:1px solid var(--line);">
    <span style="font-size:11px;text-transform:uppercase;letter-spacing:0.04em;color:var(--muted);font-weight:700;">Water / Drinks</span>
    <div style="font-size:26px;font-weight:800;color:#2563eb;margin:4px 0 2px;">
      <%= pendingList.filter(c => c.type === 'water').length %>
    </div>
    <span style="font-size:11.5px;color:var(--muted);">Drink refills requested</span>
  </div>

  <div class="card" style="margin:0;padding:14px 18px;border:1px solid var(--line);">
    <span style="font-size:11px;text-transform:uppercase;letter-spacing:0.04em;color:var(--muted);font-weight:700;">Resolved Today</span>
    <div style="font-size:26px;font-weight:800;color:#16a34a;margin:4px 0 2px;">
      <%= resolvedList.length %>
    </div>
    <span style="font-size:11.5px;color:var(--muted);">Completed service requests</span>
  </div>
</div>

<!-- FILTER TABS & CHIPS -->
<div class="card" style="margin-bottom:16px;padding:12px 18px;">
  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
    <div style="display:flex;gap:6px;flex-wrap:wrap;">
      <button type="button" class="btn btn-secondary call-filter-btn active-chip" data-filter="all" style="padding:6px 14px;font-size:12.5px;background:var(--brand);color:#fff;border-color:var(--brand);font-weight:700;">
        All Calls (<%= pendingList.length %>)
      </button>
      <button type="button" class="btn btn-secondary call-filter-btn" data-filter="bill" style="padding:6px 12px;font-size:12.5px;">
        💳 Bill
      </button>
      <button type="button" class="btn btn-secondary call-filter-btn" data-filter="water" style="padding:6px 12px;font-size:12.5px;">
        💧 Water
      </button>
      <button type="button" class="btn btn-secondary call-filter-btn" data-filter="general" style="padding:6px 12px;font-size:12.5px;">
        🛎️ Service
      </button>
    </div>

    <div>
      <button type="button" id="toggle-view-history-btn" class="btn btn-secondary" style="font-size:12.5px;padding:6px 12px;">
        📜 View Resolved Log (<%= resolvedList.length %>)
      </button>
    </div>
  </div>
</div>

<!-- ACTIVE PENDING CALLS LIST -->
<section id="pending-calls-section" class="card" style="padding:20px;box-shadow:var(--shadow-sm);border:1px solid var(--line);">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;border-bottom:1px solid var(--line);padding-bottom:10px;">
    <h3 style="margin:0;font-size:16px;color:var(--ink);">Active Guest Assistance Queue</h3>
    <span style="font-size:12px;color:var(--subtle);">Real-time socket synchronized</span>
  </div>

  <% if (!pendingList.length) { %>
    <div id="no-calls-empty" style="text-align:center;padding:56px 16px;">
      <div style="font-size:42px;margin-bottom:10px;">🛎️</div>
      <h3 style="margin:0 0 6px;color:var(--ink);">All tables attended</h3>
      <p style="color:var(--muted);margin:0;font-size:13.5px;">There are no pending assistance calls. When a guest taps their service bell, an alert will chime here.</p>
    </div>
  <% } %>

  <div id="call-items-container" style="display:grid;gap:10px;">
    <% pendingList.forEach((call) => {
      const meta = getCallMeta(call.type);
      const tableName = call.table ? call.table.table_name : 'Unknown';
    %>
      <div class="item-row call-card"
           id="call-row-<%= call.id %>"
           data-call-id="<%= call.id %>"
           data-type="<%= call.type %>"
           data-created-at="<%= new Date(call.created_at).toISOString() %>"
           style="background:#f8fafc;padding:14px 18px;border-radius:12px;border:1.5px solid <%= meta.border %>;display:flex;justify-content:space-between;align-items:center;gap:14px;box-shadow:var(--shadow-xs);transition:all 0.15s ease;">
        
        <div style="display:flex;align-items:center;gap:14px;">
          <!-- TYPE ICON BADGE -->
          <div style="width:48px;height:48px;border-radius:12px;background:<%= meta.bg %>;color:<%= meta.color %>;border:1px solid <%= meta.border %>;display:grid;place-items:center;font-size:22px;flex-shrink:0;">
            <%= meta.icon %>
          </div>

          <!-- TABLE AND REQUEST INFO -->
          <div>
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
              <strong style="font-size:17px;color:var(--ink);">Table <%= tableName %></strong>
              <span class="badge" style="background:<%= meta.bg %>;color:<%= meta.color %>;border:1px solid <%= meta.border %>;font-size:11.5px;font-weight:700;">
                <%= meta.label %>
              </span>
            </div>
            
            <div style="font-size:12.5px;color:var(--muted);margin-top:3px;display:flex;align-items:center;gap:8px;">
              <span>Called at <%= new Date(call.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
              &middot;
              <span class="badge call-elapsed" style="background:#fee2e2;color:#991b1b;font-weight:800;font-size:11px;">
                Waiting 0m
              </span>
            </div>
          </div>
        </div>

        <!-- ACTIONS -->
        <div style="display:flex;align-items:center;gap:8px;">
          <a href="/counter-admin/<%= (currentUser && currentUser.slug) ? currentUser.slug : 'demo-restaurant' %>/counter" class="btn btn-secondary" style="padding:8px 12px;font-size:12.5px;">
            Open Table ↗
          </a>
          <button type="button" class="btn resolve-call-btn" data-id="<%= call.id %>" data-table="<%= tableName %>" style="padding:8px 16px;font-size:13px;font-weight:700;background:#16a34a;border-color:#16a34a;box-shadow:none;">
            ✓ Mark Done
          </button>
        </div>
      </div>
    <% }) %>
  </div>
</section>

<!-- RESOLVED CALLS HISTORY (COLLAPSIBLE) -->
<section id="resolved-calls-section" class="card" style="display:none;margin-top:16px;padding:20px;background:#fafaf9;border:1px solid var(--line);">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;border-bottom:1px solid var(--line);padding-bottom:10px;">
    <div>
      <h3 style="margin:0;font-size:16px;color:var(--ink);">Service Log (Resolved Today)</h3>
      <span style="font-size:12px;color:var(--muted);">Audit of completed table service requests</span>
    </div>
    <% if (resolvedList.length) { %>
      <button type="button" id="btn-clear-resolved" class="btn btn-secondary" style="font-size:11.5px;padding:5px 10px;color:#be123c;">
        Clear Log
      </button>
    <% } %>
  </div>

  <% if (!resolvedList.length) { %>
    <p style="text-align:center;color:var(--muted);padding:20px 0;margin:0;">No resolved calls logged yet today.</p>
  <% } else { %>
    <div style="display:grid;gap:8px;">
      <% resolvedList.forEach((rc) => {
        const meta = getCallMeta(rc.type);
      %>
        <div class="item-row" style="background:#ffffff;padding:10px 14px;border-radius:8px;border:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;">
          <div style="display:flex;align-items:center;gap:10px;">
            <span><%= meta.icon %></span>
            <div>
              <strong style="color:var(--ink);font-size:14px;">Table <%= rc.table ? rc.table.table_name : 'Unknown' %></strong>
              <span style="color:var(--muted);font-size:12px;margin-left:6px;"><%= meta.label %></span>
            </div>
          </div>
          <span style="font-size:12px;color:var(--muted);">
            Resolved at <%= rc.resolved_at ? new Date(rc.resolved_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : 'Done' %>
          </span>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>

<script src="/socket.io/socket.io.js"></script>
<script>
  (function() {
    const toast = document.getElementById('call-toast');
    const toastText = document.getElementById('toast-text');
    const toastIcon = document.getElementById('toast-icon');

    function showToast(msg, isError = false) {
      toastText.textContent = msg;
      toastIcon.textContent = isError ? '⚠️' : '✓';
      toast.style.background = isError ? '#991b1b' : '#065f46';
      toast.style.color = '#ffffff';
      toast.style.display = 'flex';
      setTimeout(() => { toast.style.display = 'none'; }, 3000);
    }

    // Audio Alert Synthesizer
    let soundEnabled = true;
    const soundBtn = document.getElementById('toggle-call-sound');
    const soundLabel = document.getElementById('call-sound-label');
    const soundIcon = document.getElementById('call-sound-icon');

    soundBtn.addEventListener('click', () => {
      soundEnabled = !soundEnabled;
      soundLabel.textContent = soundEnabled ? 'Audio: ON' : 'Audio: OFF';
      soundIcon.textContent = soundEnabled ? '🔔' : '🔕';
      if (soundEnabled) playBellChime();
    });

    function playBellChime() {
      if (!soundEnabled) return;
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(880, ctx.currentTime); // A5
        osc.frequency.setValueAtTime(1174.66, ctx.currentTime + 0.12); // D6
        gain.gain.setValueAtTime(0.25, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.5);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.5);
      } catch (e) {}
    }

    // Elapsed timers
    function updateTimers() {
      document.querySelectorAll('.call-card').forEach(card => {
        const createdAt = Date.parse(card.dataset.createdAt);
        if (isNaN(createdAt)) return;
        const mins = Math.max(0, Math.floor((Date.now() - createdAt) / 60000));
        const badge = card.querySelector('.call-elapsed');
        if (badge) badge.textContent = `Waiting ${mins}m`;
      });
    }
    updateTimers();
    setInterval(updateTimers, 15000);

    // In-place Resolve Button Click
    document.querySelectorAll('.resolve-call-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        const id = btn.dataset.id;
        const table = btn.dataset.table;
        btn.disabled = true;
        btn.textContent = 'Resolving...';

        try {
          const res = await fetch(`/staff-calls/${id}/resolve`, { method: 'POST' });
          const data = await res.json();
          if (res.ok && data.success) {
            const row = document.getElementById(`call-row-${id}`);
            if (row) {
              row.style.opacity = '0';
              row.style.transform = 'scale(0.95)';
              setTimeout(() => {
                row.remove();
                updateBadgeCount();
              }, 250);
            }
            showToast(`Table ${table} call marked resolved!`);
          } else {
            btn.disabled = false;
            btn.textContent = '✓ Mark Done';
            alert(data.message || 'Could not resolve call.');
          }
        } catch (err) {
          btn.disabled = false;
          btn.textContent = '✓ Mark Done';
        }
      });
    });

    function updateBadgeCount() {
      const remaining = document.querySelectorAll('.call-card').length;
      const badge = document.getElementById('pending-count-badge');
      const kpi = document.getElementById('kpi-pending-count');
      if (badge) badge.textContent = `${remaining} Active Call${remaining === 1 ? '' : 's'}`;
      if (kpi) kpi.textContent = remaining;

      if (remaining === 0) {
        const container = document.getElementById('call-items-container');
        if (container) {
          container.innerHTML = `
            <div id="no-calls-empty" style="text-align:center;padding:56px 16px;">
              <div style="font-size:42px;margin-bottom:10px;">🛎️</div>
              <h3 style="margin:0 0 6px;color:var(--ink);">All tables attended</h3>
              <p style="color:var(--muted);margin:0;font-size:13.5px;">There are no pending assistance calls.</p>
            </div>`;
        }
      }
    }

    // Toggle Resolved Log
    const toggleHistoryBtn = document.getElementById('toggle-view-history-btn');
    const historySection = document.getElementById('resolved-calls-section');
    toggleHistoryBtn.addEventListener('click', () => {
      const isOpen = historySection.style.display !== 'none';
      historySection.style.display = isOpen ? 'none' : 'block';
      toggleHistoryBtn.textContent = isOpen ? '📜 View Resolved Log' : '✕ Hide Resolved Log';
    });

    // Clear Resolved Log
    const clearBtn = document.getElementById('btn-clear-resolved');
    if (clearBtn) {
      clearBtn.addEventListener('click', async () => {
        if (!confirm('Clear all resolved logs for today?')) return;
        await fetch('/staff-calls/clear-resolved', { method: 'POST' });
        historySection.innerHTML = '<p style="text-align:center;color:var(--muted);padding:16px;">Log cleared.</p>';
      });
    }

    // Filter Chips
    document.querySelectorAll('.call-filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.call-filter-btn').forEach(b => {
          b.style.background = '#fff';
          b.style.color = 'var(--ink-secondary)';
          b.style.borderColor = 'var(--line)';
        });
        btn.style.background = 'var(--brand)';
        btn.style.color = '#fff';
        btn.style.borderColor = 'var(--brand)';

        const f = btn.dataset.filter;
        document.querySelectorAll('.call-card').forEach(card => {
          card.style.display = (f === 'all' || card.dataset.type === f) ? 'flex' : 'none';
        });
      });
    });

    // Socket.IO Real-time Connection
    const socket = io();
    socket.emit('join-restaurant', <%= currentUser.id %>);
    socket.on('restaurant-update', (event) => {
      if (event.reason === 'staff-call') {
        playBellChime();
        showToast(`🛎️ New call from Table ${event.tableName || ''}!`);
        setTimeout(() => location.reload(), 600);
      } else if (event.reason === 'staff-call-updated') {
        setTimeout(() => location.reload(), 600);
      }
    });

  })();
</script>