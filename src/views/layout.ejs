<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#f97316">
  <title><%= typeof title !== 'undefined' ? title : 'Tablely' %></title>
  <style>
    :root { --ink:#172033; --muted:#687386; --line:#e7eaf0; --canvas:#f6f7fb; --surface:#fff; --brand:#f97316; --brand-dark:#d95f05; --brand-soft:#fff1e7; --shadow:0 12px 32px rgba(23,32,51,.08); }
    * { box-sizing:border-box; } body { min-height:100vh; margin:0; font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif; background:var(--canvas); color:var(--ink); } a { color:inherit; } button,input,select,textarea { font:inherit; }
    .app-shell { min-height:100vh; display:grid; grid-template-columns:264px minmax(0,1fr); } .sidebar { position:sticky; top:0; height:100vh; display:flex; flex-direction:column; padding:22px 14px; background:#182235; color:#d7dfec; overflow-y:auto; }
    .brand { display:flex; align-items:center; gap:11px; padding:4px 10px 24px; color:#fff; text-decoration:none; } .brand-mark { display:grid; place-items:center; width:34px; height:34px; color:#fff; background:var(--brand); border-radius:11px; font-size:18px; box-shadow:0 7px 16px rgba(249,115,22,.3); } .brand-name { font-size:19px; font-weight:800; letter-spacing:-.6px; }
    .workspace-label { padding:0 10px 10px; color:#8d9ab1; font-size:10px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; } .side-nav { display:grid; gap:3px; } .side-nav a { display:flex; align-items:center; gap:11px; padding:10px 12px; border-radius:9px; color:#c3cddd; text-decoration:none; font-size:14px; font-weight:650; transition:background .15s,color .15s; } .side-nav a:hover { background:#26334b; color:#fff; } .side-nav a.active { background:var(--brand); color:#fff; box-shadow:0 7px 18px rgba(0,0,0,.17); } .nav-icon { display:grid; place-items:center; width:18px; font-size:15px; } .nav-separator { height:1px; margin:14px 10px; background:#2e3b53; }
    .sidebar-user { display:flex; align-items:center; gap:10px; margin-top:auto; padding:16px 10px 2px; border-top:1px solid #2e3b53; } .avatar { display:grid; place-items:center; flex:0 0 auto; width:35px; height:35px; border-radius:50%; background:#35435c; color:#fff; font-size:13px; font-weight:800; } .user-copy { min-width:0; flex:1; } .user-copy strong,.user-copy span { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; } .user-copy strong { color:#fff; font-size:13px; } .user-copy span { margin-top:2px; color:#99a7bc; font-size:11px; } .signout { color:#aeb9ca; text-decoration:none; font-size:16px; }
    .app-main { min-width:0; display:flex; flex-direction:column; } .topbar { position:sticky; z-index:10; top:0; display:flex; align-items:center; justify-content:space-between; min-height:72px; padding:0 34px; background:rgba(255,255,255,.92); border-bottom:1px solid var(--line); backdrop-filter:blur(12px); } .topbar-copy { display:flex; align-items:center; gap:12px; } .topbar h1 { margin:0; font-size:18px; letter-spacing:-.35px; } .topbar p { margin:3px 0 0; color:var(--muted); font-size:12px; } .topbar-actions { display:flex; align-items:center; gap:10px; } .header-link { padding:8px 12px; border:1px solid var(--line); border-radius:8px; color:#4e5b70; font-size:13px; font-weight:700; text-decoration:none; } .header-link:hover { border-color:#fdba74; background:var(--brand-soft); color:var(--brand-dark); } .menu-toggle { display:none; border:0; background:transparent; color:var(--ink); font-size:22px; cursor:pointer; }
    .content { width:min(1240px,100%); margin:0 auto; padding:32px 34px 42px; flex:1; } .card { margin-bottom:16px; padding:20px; background:var(--surface); border:1px solid var(--line); border-radius:14px; box-shadow:0 2px 7px rgba(23,32,51,.025); } .card h1,.card h2,.card h3,.card h4 { margin-top:0; letter-spacing:-.35px; } .card h2 { font-size:20px; } .card h3 { font-size:16px; } .btn { display:inline-flex; align-items:center; justify-content:center; min-height:39px; padding:9px 14px; border:0; border-radius:8px; background:var(--brand); color:#fff; cursor:pointer; font-size:13px; font-weight:750; line-height:1; text-decoration:none; transition:transform .15s,background .15s; } .btn:hover { background:var(--brand-dark); transform:translateY(-1px); } .btn-secondary { background:#334155; } .btn-secondary:hover { background:#1e293b; }
    input,select,textarea { width:100%; margin:5px 0 14px; padding:10px 11px; border:1px solid #d8dee8; border-radius:8px; background:#fff; color:var(--ink); outline:none; } input:focus,select:focus,textarea:focus { border-color:#fb923c; box-shadow:0 0 0 3px rgba(249,115,22,.14); } label { color:#465267; font-size:13px; font-weight:700; } .message,.alert { padding:11px 13px; margin-bottom:14px; border-radius:8px; background:#fff0f0; color:#a83838; font-size:13px; } .item-row { display:flex; justify-content:space-between; align-items:center; gap:14px; padding:11px 0; border-bottom:1px solid #edf0f4; } .item-row:last-child { border-bottom:0; }
    .app-footer { display:flex; justify-content:space-between; gap:16px; padding:20px 34px; color:#7c8799; border-top:1px solid var(--line); background:#fff; font-size:12px; } .public-shell { min-height:100vh; display:flex; flex-direction:column; } .public-header { display:flex; align-items:center; justify-content:space-between; max-width:1120px; width:100%; min-height:72px; margin:0 auto; padding:0 24px; } .public-content { width:min(720px,100%); margin:0 auto; padding:42px 24px; flex:1; } .public-footer { max-width:1120px; width:100%; margin:0 auto; padding:20px 24px; color:#7c8799; border-top:1px solid var(--line); font-size:12px; }
    @media (max-width:820px) { .app-shell { display:block; } .sidebar { position:fixed; z-index:30; left:0; width:264px; transform:translateX(-100%); transition:transform .2s ease; box-shadow:16px 0 35px rgba(15,23,42,.24); } body.nav-open { overflow:hidden; } body.nav-open .sidebar { transform:translateX(0); } .topbar { min-height:64px; padding:0 18px; } .menu-toggle { display:block; } .topbar h1 { font-size:16px; } .topbar p { display:none; } .content { padding:22px 18px 30px; } .app-footer { padding:17px 18px; } } @media (max-width:520px) { .topbar-actions .header-link { display:none; } .card { padding:16px; border-radius:12px; } .public-header,.public-content,.public-footer { padding-left:18px; padding-right:18px; } .public-content { padding-top:28px; } .app-footer { flex-direction:column; } }
  </style>
</head>
<body>
  <% const pathName = typeof currentPath !== 'undefined' ? currentPath : ''; const isOwner = currentUser && currentUser.user_type === 'R'; const isSuperAdmin = currentUser && currentUser.user_type === 'S'; const isKitchen = currentUser && currentUser.user_type === 'K'; const isCounter = currentUser && currentUser.user_type === 'Co'; const initials = currentUser && currentUser.name ? currentUser.name.split(/\s+/).map(part => part[0]).slice(0,2).join('').toUpperCase() : 'T'; %>
  <% if (currentUser) { %>
  <div class="app-shell"><aside class="sidebar" id="sidebar"><a class="brand" href="<%= isSuperAdmin ? '/superadmin/dashboard' : isOwner ? '/dashboard' : isKitchen ? '/kitchen-admin/kitchen' : isCounter ? '/counter-admin/' + currentUser.slug + '/counter' : '/home' %>"><span class="brand-mark">✦</span><span class="brand-name">Tablely</span></a><div class="workspace-label"><%= isSuperAdmin ? 'Platform workspace' : isOwner ? 'Restaurant workspace' : isKitchen ? 'Kitchen workspace' : 'Counter workspace' %></div><nav class="side-nav" aria-label="Main navigation">
    <% if (isOwner) { %>
    <a class="<%= pathName === '/dashboard' ? 'active' : '' %>" href="/dashboard"><span class="nav-icon">⌂</span>Overview</a><a class="<%= pathName.startsWith('/categories') ? 'active' : '' %>" href="/categories"><span class="nav-icon">◫</span>Categories</a><a class="<%= pathName.startsWith('/menus') ? 'active' : '' %>" href="/menus"><span class="nav-icon">☷</span>Menu items</a><a class="<%= pathName.startsWith('/tables') ? 'active' : '' %>" href="/tables"><span class="nav-icon">▦</span>Tables</a><a class="<%= pathName.startsWith('/waiters') ? 'active' : '' %>" href="/waiters"><span class="nav-icon">♙</span>Team</a><div class="nav-separator"></div><a class="<%= pathName.startsWith('/discounts') || pathName.startsWith('/promotions') ? 'active' : '' %>" href="/promotions"><span class="nav-icon">✧</span>Promotions</a><a class="<%= pathName.startsWith('/inventory') ? 'active' : '' %>" href="/inventory"><span class="nav-icon">◈</span>Inventory</a><a class="<%= pathName.startsWith('/order-summary') || pathName.startsWith('/order-report') || pathName.startsWith('/table-order') ? 'active' : '' %>" href="/order-summary"><span class="nav-icon">▤</span>Reports</a><div class="nav-separator"></div><a href="/counter-admin/<%= currentUser.slug %>/counter"><span class="nav-icon">▣</span>Counter</a><a href="/kitchen-admin/kitchen"><span class="nav-icon">♨</span>Kitchen board</a>
    <a class="<%= pathName.startsWith('/staff-calls') ? 'active' : '' %>" href="/staff-calls"><span class="nav-icon">♧</span>Staff calls</a>
    <% } else if (isSuperAdmin) { %>
    <a class="<%= pathName === '/superadmin/dashboard' ? 'active' : '' %>" href="/superadmin/dashboard"><span class="nav-icon">⌂</span>Overview</a><a class="<%= pathName.startsWith('/superadmin/restaurants') ? 'active' : '' %>" href="/superadmin/restaurants"><span class="nav-icon">◫</span>Restaurants</a><a class="<%= pathName.startsWith('/superadmin/subscriptions') ? 'active' : '' %>" href="/superadmin/subscriptions"><span class="nav-icon">◇</span>Subscriptions</a><a class="<%= pathName.startsWith('/superadmin/setting') ? 'active' : '' %>" href="/superadmin/setting"><span class="nav-icon">⚙</span>Settings</a>
    <% } else if (isKitchen) { %><a class="<%= pathName === '/kitchen-admin/kitchen' ? 'active' : '' %>" href="/kitchen-admin/kitchen"><span class="nav-icon">♨</span>Kitchen board</a><a class="<%= pathName === '/kitchen-admin/bar' ? 'active' : '' %>" href="/kitchen-admin/bar"><span class="nav-icon">◒</span>Bar board</a>
    <% } else if (isCounter) { %><a class="active" href="/counter-admin/<%= currentUser.slug %>/counter"><span class="nav-icon">▣</span>Counter</a><% } %>
  </nav><div class="sidebar-user"><span class="avatar"><%= initials %></span><div class="user-copy"><strong><%= currentUser.name %></strong><span><%= isSuperAdmin ? 'Administrator' : isOwner ? 'Restaurant owner' : isKitchen ? 'Kitchen staff' : 'Counter staff' %></span></div><a class="signout" href="/logout" aria-label="Sign out">↗</a></div></aside>
  <main class="app-main"><header class="topbar"><div class="topbar-copy"><button class="menu-toggle" type="button" aria-label="Open navigation" aria-controls="sidebar">☰</button><div><h1><%= typeof title !== 'undefined' ? title : 'Workspace' %></h1><p><%= new Date().toLocaleDateString('en-US',{weekday:'long',month:'short',day:'numeric'}) %></p></div></div><div class="topbar-actions"><a class="header-link" href="<%= isOwner ? '/dashboard' : isSuperAdmin ? '/superadmin/dashboard' : '/home' %>">Workspace</a><span class="avatar"><%= initials %></span></div></header><section class="content"><%- body %></section><footer class="app-footer"><span>© <%= new Date().getFullYear() %> Tablely. Built for better service.</span><span>Restaurant operations, simplified.</span></footer></main></div>
  <% } else { %>
  <div class="public-shell"><header class="public-header"><a class="brand" href="/"><span class="brand-mark">✦</span><span class="brand-name" style="color:var(--ink)">Tablely</span></a><a class="header-link" href="/login">Sign in</a></header><main class="public-content"><%- body %></main><footer class="public-footer">© <%= new Date().getFullYear() %> Tablely · Thoughtful dining, served simply.</footer></div>
  <% } %>
  <script>const menuToggle=document.querySelector('.menu-toggle');if(menuToggle)menuToggle.addEventListener('click',()=>document.body.classList.toggle('nav-open'));</script>
</body>
</html>
