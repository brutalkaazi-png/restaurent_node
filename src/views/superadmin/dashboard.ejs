<!-- 5 PLATFORM KPI SUMMARY CARDS -->
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:16px;margin-bottom:24px;">
  <!-- Total Tenants -->
  <div class="card" style="margin:0;border:1px solid var(--line);box-shadow:var(--shadow-xs);">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
      <span style="font-size:11.5px;text-transform:uppercase;letter-spacing:0.04em;color:var(--muted);font-weight:700;">Tenants Onboarded</span>
      <span style="display:inline-grid;place-items:center;width:28px;height:28px;border-radius:6px;background:#f8fafc;color:var(--brand);font-size:15px;font-weight:800;">◫</span>
    </div>
    <div style="font-size:28px;font-weight:800;color:var(--ink);margin-bottom:2px;"><%= totalRestaurants %></div>
    <span style="font-size:12px;color:var(--muted);">
      <%= approvedRestaurants %> active &middot; <strong style="color:<%= pendingRestaurants > 0 ? '#ea580c' : '#16a34a' %>"><%= pendingRestaurants %> pending</strong>
    </span>
  </div>

  <!-- Active Subscriptions -->
  <div class="card" style="margin:0;border:1px solid var(--line);box-shadow:var(--shadow-xs);">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
      <span style="font-size:11.5px;text-transform:uppercase;letter-spacing:0.04em;color:var(--muted);font-weight:700;">Active Subscriptions</span>
      <span style="display:inline-grid;place-items:center;width:28px;height:28px;border-radius:6px;background:#eff6ff;color:#2563eb;font-size:15px;font-weight:800;">◇</span>
    </div>
    <div style="font-size:28px;font-weight:800;color:#2563eb;margin-bottom:2px;"><%= totalSubscribed %></div>
    <span style="font-size:12px;color:var(--muted);"><%= subRate %>% tenant paid conversion rate</span>
  </div>

  <!-- Subscription Run Rate -->
  <div class="card" style="margin:0;border:1px solid var(--line);box-shadow:var(--shadow-xs);">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
      <span style="font-size:11.5px;text-transform:uppercase;letter-spacing:0.04em;color:var(--muted);font-weight:700;">Subscription MRR</span>
      <span style="display:inline-grid;place-items:center;width:28px;height:28px;border-radius:6px;background:#ecfdf5;color:#059669;font-size:15px;font-weight:800;">$</span>
    </div>
    <div style="font-size:28px;font-weight:800;color:#16a34a;margin-bottom:2px;">$<%= estimatedMrr.toFixed(2) %></div>
    <span style="font-size:12px;color:var(--muted);">Recurring SaaS subscription run rate</span>
  </div>

  <!-- Network Gross Orders (GMV) -->
  <div class="card" style="margin:0;border:1px solid var(--line);box-shadow:var(--shadow-xs);">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
      <span style="font-size:11.5px;text-transform:uppercase;letter-spacing:0.04em;color:var(--muted);font-weight:700;">Network GMV</span>
      <span style="display:inline-grid;place-items:center;width:28px;height:28px;border-radius:6px;background:#fff7ed;color:#ea580c;font-size:15px;font-weight:800;">🛍️</span>
    </div>
    <div style="font-size:28px;font-weight:800;color:var(--brand);margin-bottom:2px;">$<%= sales.toFixed(2) %></div>
    <span style="font-size:12px;color:var(--muted);"><%= orders %> dine-in & online customer orders</span>
  </div>

  <!-- Average Ticket Size -->
  <div class="card" style="margin:0;border:1px solid var(--line);box-shadow:var(--shadow-xs);">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
      <span style="font-size:11.5px;text-transform:uppercase;letter-spacing:0.04em;color:var(--muted);font-weight:700;">Average Ticket</span>
      <span style="display:inline-grid;place-items:center;width:28px;height:28px;border-radius:6px;background:#fdf2f8;color:#be185d;font-size:15px;font-weight:800;">◷</span>
    </div>
    <div style="font-size:28px;font-weight:800;color:var(--ink);margin-bottom:2px;">$<%= aov.toFixed(2) %></div>
    <span style="font-size:12px;color:var(--muted);">Platform-wide order size</span>
  </div>
</div>

<!-- TWO-COLUMN WORKSPACE: LEFT (SUBSCRIPTIONS BREAKDOWN) & RIGHT (RECENT TENANTS) -->
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(330px,1fr));gap:20px;margin-bottom:28px;align-items:start;">
  <!-- SUBSCRIPTIONS BY TIER -->
  <div class="card" style="margin:0;border:1px solid var(--line);">
    <div style="display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:12px;margin-bottom:16px;">
      <div>
        <h3 style="margin:0;font-size:17px;color:var(--ink);">Active Subscription Plans</h3>
        <span style="font-size:12px;color:var(--muted);">Adoption rates per billing tier</span>
      </div>
      <a class="btn btn-secondary btn-sm" href="/superadmin/subscriptions">Manage Plans ↗</a>
    </div>

    <% if (!subscriptions.length) { %>
      <div style="text-align:center;padding:32px 0;color:var(--muted);">
        No subscription plans defined yet.
      </div>
    <% } else { %>
      <div style="display:grid;gap:10px;">
        <% subscriptions.forEach(function(sub) { %>
          <%
            const userCount = (typeof subscriptionCountsMap !== 'undefined' && subscriptionCountsMap[sub.id]) ? subscriptionCountsMap[sub.id] : 0;
            const pctOfTotal = totalSubscribed > 0 ? Math.round((userCount / totalSubscribed) * 100) : 0;
          %>
          <div style="background:#f8fafc;padding:12px 16px;border-radius:10px;border:1px solid var(--line);">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
              <div>
                <strong style="font-size:15px;color:var(--ink);"><%= sub.name %></strong>
                <span style="font-size:12px;color:var(--muted);margin-left:6px;">
                  $<%= parseFloat(sub.cost || 0).toFixed(2) %> / <%= sub.month %> mo
                </span>
              </div>
              <span class="badge" style="background:#dbeafe;color:#1e40af;font-weight:700;font-size:12px;">
                <%= userCount %> Subscriber<%= userCount === 1 ? '' : 's' %>
              </span>
            </div>

            <!-- Progress bar -->
            <div style="height:6px;border-radius:3px;background:#e2e8f0;overflow:hidden;margin-top:8px;">
              <div style="height:100%;background:linear-gradient(90deg, #f97316, #ea580c);width:<%= pctOfTotal %>%;"></div>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:11.5px;color:var(--muted);margin-top:4px;">
              <span>Plan share:</span>
              <span><%= pctOfTotal %>% of active subscriptions</span>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- RECENT TENANTS & ONBOARDING -->
  <div class="card" style="margin:0;border:1px solid var(--line);">
    <div style="display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:12px;margin-bottom:16px;">
      <div>
        <h3 style="margin:0;font-size:17px;color:var(--ink);">Recent Tenant Accounts</h3>
        <span style="font-size:12px;color:var(--muted);">Latest restaurants onboarded to platform</span>
      </div>
      <a class="btn btn-secondary btn-sm" href="/superadmin/restaurants">View All Tenants ↗</a>
    </div>

    <% if (!recentRestaurants.length) { %>
      <div style="text-align:center;padding:32px 0;color:var(--muted);">
        No restaurant accounts registered yet.
      </div>
    <% } else { %>
      <div style="display:grid;gap:10px;">
        <% recentRestaurants.forEach(function(r) { %>
          <% const isApproved = r.status === 'approved'; %>
          <div class="item-row" style="padding:10px 14px;background:#f8fafc;border-radius:8px;border:1px solid var(--line);margin:0;display:flex;justify-content:space-between;align-items:center;">
            <div>
              <div style="display:flex;align-items:center;gap:8px;">
                <strong style="color:var(--ink);font-size:14.5px;"><%= r.name %></strong>
                <span class="badge <%= isApproved ? 'status-available' : 'status-occupied' %>" style="font-size:10.5px;text-transform:capitalize;padding:2px 8px;">
                  <%= r.status %>
                </span>
              </div>
              <div style="font-size:12px;color:var(--muted);margin-top:2px;">
                <%= r.email %> &middot; <%= r.slug %>
              </div>
            </div>

            <div style="display:flex;gap:6px;">
              <a href="/superadmin/restaurant/edit/<%= r.id %>" class="btn btn-secondary" style="padding:5px 10px;font-size:12px;">
                Edit
              </a>
              <% if (!isApproved) { %>
                <form method="POST" action="/superadmin/restaurant-change-status" style="margin:0;display:inline;">
                  <input type="hidden" name="res_id" value="<%= r.id %>">
                  <input type="hidden" name="status" value="approved">
                  <button type="submit" class="btn" style="padding:5px 10px;font-size:12px;background:#16a34a;border-color:#16a34a;">
                    Approve
                  </button>
                </form>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<!-- PLATFORM OPERATIONS LAUNCHPAD -->
<div style="margin:24px 0 14px;display:flex;align-items:center;justify-content:space-between;">
  <h3 style="margin:0;font-size:16px;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted);">Platform Management Hubs</h3>
  <span style="font-size:12px;color:var(--subtle);">Core administrative controls</span>
</div>

<div class="quick-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px;">
  <!-- Restaurants Directory -->
  <a class="quick-link" href="/superadmin/restaurants" style="text-decoration:none;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
      <span class="quick-icon" style="background:#eff6ff;color:#2563eb;margin:0;">◫</span>
      <span class="badge" style="font-size:11px;font-weight:700;"><%= totalRestaurants %> Total</span>
    </div>
    <strong style="color:var(--ink);">Tenant Accounts & Approvals</strong>
    <span style="color:var(--muted);font-size:13px;margin-top:4px;">Approve new restaurant sign-ups, edit tenant profiles, view order histories.</span>
  </a>

  <!-- Subscription Plans -->
  <a class="quick-link" href="/superadmin/subscriptions" style="text-decoration:none;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
      <span class="quick-icon" style="background:#ecfdf5;color:#059669;margin:0;">◇</span>
      <span class="badge" style="font-size:11px;font-weight:700;"><%= subscriptions.length %> Plans</span>
    </div>
    <strong style="color:var(--ink);">Subscription Tier Plans</strong>
    <span style="color:var(--muted);font-size:13px;margin-top:4px;">Define pricing models, monthly costs, and plan durations.</span>
  </a>

  <!-- Platform Settings -->
  <a class="quick-link" href="/superadmin/setting" style="text-decoration:none;">
    <span class="quick-icon" style="background:#fffbeb;color:#d97706;margin-bottom:12px;">⚙</span>
    <strong style="color:var(--ink);">Global Platform Settings</strong>
    <span style="color:var(--muted);font-size:13px;margin-top:4px;">System currency symbols, support emails, brand names, and platform configuration.</span>
  </a>

  <!-- Demo Restaurant Switcher -->
  <a class="quick-link" href="/dashboard" target="_blank" rel="noopener" style="text-decoration:none;">
    <span class="quick-icon" style="background:#fff7ed;color:var(--brand);margin-bottom:12px;">↗</span>
    <strong style="color:var(--ink);">Inspect Demo Restaurant</strong>
    <span style="color:var(--muted);font-size:13px;margin-top:4px;">Live preview of the tenant POS, kitchen KDS, and table QR ordering menus.</span>
  </a>
</div>