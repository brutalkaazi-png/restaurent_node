<%
const sales = parseFloat(platformSales || 0);
const orders = parseInt(platformOrders || 0);
const aov = orders > 0 ? (sales / orders) : 0;
const subRate = totalRestaurants > 0 ? Math.round((totalSubscribed / totalRestaurants) * 100) : 0;
%>

<!-- HERO WELCOME BANNER -->
<div class="card welcome-card" style="margin-bottom:20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:20px;">
  <div style="flex:1;min-width:300px;">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px;">
      <span class="badge" style="background:#e0e7ff;color:#3730a3;font-weight:800;font-size:11px;">● MULTI-TENANT SAAS ROOT</span>
      <span style="font-size:12px;color:var(--muted);"><%= currentUser ? currentUser.name : 'Super Admin' %></span>
    </div>
    <h2 style="margin:0 0 6px;font-size:24px;letter-spacing:-0.02em;">Platform Overview & Command Center</h2>
    <p style="margin:0;color:var(--muted);font-size:13.5px;max-width:680px;line-height:1.5;">
      Monitor global tenant sign-ups, recurring subscription tiers, network GMV across restaurants, and system health.
    </p>
  </div>
  
  <div style="display:inline-flex;align-items:center;gap:10px;flex-shrink:0;">
    <a class="btn" href="/superadmin/restaurants" style="box-shadow:var(--shadow-brand);padding:9px 18px;font-size:13.5px;font-weight:700;">
      <span>👥</span> Manage Tenants (<%= totalRestaurants %>)
    </a>
    <a class="btn btn-secondary" href="/superadmin/subscriptions/create" style="padding:9px 16px;font-size:13.5px;">
      <span>+</span> Create Plan
    </a>
  </div>
</div>

