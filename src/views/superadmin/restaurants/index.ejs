<div class="card">
  <h2>Restaurants</h2>
  <form method="GET" action="/superadmin/restaurants">
    <label>Search (name/phone)</label>
    <input type="text" name="query" value="<%= query %>">
    <label>Status</label>
    <select name="status">
      <option value="">Any</option>
      <option value="pending" <%= status === 'pending' ? 'selected' : '' %>>Pending</option>
      <option value="approved" <%= status === 'approved' ? 'selected' : '' %>>Approved</option>
    </select>
    <label>Subscription</label>
    <select name="subscription_status">
      <option value="">Any</option>
      <option value="subscribed" <%= subscriptionStatus === 'subscribed' ? 'selected' : '' %>>Subscribed</option>
      <option value="unsubscribed" <%= subscriptionStatus === 'unsubscribed' ? 'selected' : '' %>>Unsubscribed</option>
    </select>
    <button class="btn" type="submit">Filter</button>
  </form>
</div>

<% restaurants.forEach(function(r) { %>
  <div class="card">
    <div class="item-row">
      <div>
        <strong><%= r.name %></strong>
        <div style="font-size:0.85em;color:#777;"><%= r.email %> &middot; <%= r.phone || '' %></div>
        <div style="font-size:0.85em;">
          Status: <span class="item-status"><%= r.status %></span>
          <% if (r.has_subscription) { %> &middot; Subscribed (<%= r.subscription_name %>)<% } else { %> &middot; Not subscribed<% } %>
        </div>
      </div>
      <div>
        <a class="btn" href="/superadmin/restaurant/edit/<%= r.id %>">Edit</a>
        <a class="btn btn-secondary" href="/superadmin/view-subscription/<%= r.id %>">Subscriptions</a>
        <a class="btn btn-secondary" href="/superadmin/view-order-detail/<%= r.id %>">Orders</a>
      </div>
    </div>
    <% if (r.status !== 'approved') { %>
      <form method="POST" action="/superadmin/restaurant-change-status" style="margin-top:8px;">
        <input type="hidden" name="res_id" value="<%= r.id %>">
        <input type="hidden" name="status" value="approved">
        <button type="submit" class="btn">Approve</button>
      </form>
    <% } %>
    <form method="POST" action="/superadmin/restaurant/delete/<%= r.id %>" onsubmit="return confirm('Remove this restaurant?');" style="margin-top:4px;">
      <button type="submit" class="btn btn-secondary">Remove</button>
    </form>
  </div>
<% }) %>

<div class="card">
  <% for (let p = 1; p <= totalPages; p++) { %>
    <a class="btn <%= p === page ? '' : 'btn-secondary' %>" href="?page=<%= p %>&query=<%= query %>&status=<%= status %>">
      <%= p %>
    </a>
  <% } %>
</div>
