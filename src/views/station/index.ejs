<%
function statusLabel(status) {
  if (status === 'preparing') return 'Cooking';
  if (status === 'order_delivered') return 'Ready';
  if (status === 'cancelled') return 'Cancelled';
  return 'Pending';
}

const categories = [...new Set(activeOrders.map((order) => order.item && order.item.category ? order.item.category.category_name : 'Uncategorized'))].sort();
%>
<style>
  .station-hero { background:#172033; color:#fff; }
  .station-hero p { color:#b8c3d6; margin-bottom:0; }
  .station-toolbar { display:flex; align-items:end; justify-content:space-between; gap:16px; flex-wrap:wrap; }
  .station-toolbar label { color:#d7dfec; }
  .station-toolbar select { width:auto; min-width:180px; margin:6px 0 0; background:#26334b; border-color:#50607b; color:#fff; }
  .ticket-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:16px; }
  .ticket { display:flex; flex-direction:column; min-height:250px; padding:18px; background:#202c42; color:#f8fafc; border:2px solid #33445f; border-radius:12px; box-shadow:0 10px 20px rgba(15,23,42,.16); }
  .ticket[hidden] { display:none; }
  .ticket-head,.ticket-foot,.ticket-line { display:flex; align-items:center; justify-content:space-between; gap:12px; }
  .ticket-head { align-items:start; padding-bottom:14px; border-bottom:1px solid #3d4d66; }
  .ticket h3 { margin:0; color:#fff; font-size:18px; }
  .ticket-meta,.ticket-note { color:#b8c3d6; font-size:13px; }
  .elapsed { flex:0 0 auto; padding:5px 8px; border-radius:999px; color:#102014; background:#86efac; font-size:12px; font-weight:800; }
  .ticket.urgent-warn { border-color:#fbbf24; } .ticket.urgent-warn .elapsed { background:#fbbf24; }
  .ticket.urgent-danger { border-color:#f87171; } .ticket.urgent-danger .elapsed { background:#f87171; color:#3b0a0a; }
  .ticket-lines { flex:1; padding:12px 0; } .ticket-line { padding:7px 0; border-bottom:1px solid #33445f; }
  .ticket-line:last-child { border-bottom:0; } .ticket-line strong { color:#fff; } .ticket-note { margin:4px 0 0; }
  .ticket-actions { display:flex; flex-wrap:wrap; gap:8px; } .ticket button { border:0; border-radius:7px; padding:8px 10px; color:#fff; background:#f97316; cursor:pointer; font-weight:700; }
  .ticket button:hover { background:#fb923c; } .ticket button.secondary { background:#475569; } .ticket button.sold-out { background:#be123c; }
  .empty-state { text-align:center; color:#687386; }
  @media (max-width:520px) { .ticket-grid { grid-template-columns:1fr; } .station-toolbar select { width:100%; } }
</style>

<section class="card station-hero">
  <div class="station-toolbar">
    <div>
      <h2><%= station === 'bar' ? 'Bar' : 'Kitchen' %> ticket board</h2>
      <p>Incoming tickets update live. Status changes are shared with the counter.</p>
    </div>
    <label for="station-category">Filter category
      <select id="station-category" aria-label="Filter kitchen tickets by category">
        <option value="all">All categories</option>
        <% categories.forEach((category) => { %><option value="<%= category %>"><%= category %></option><% }) %>
      </select>
    </label>
  </div>
</section>

<% if (!activeOrders.length) { %>
  <section class="card empty-state" role="status"><h3>No active tickets</h3><p>New orders will appear here automatically.</p></section>
<% } else { %>
  <section class="ticket-grid" aria-label="Active kitchen tickets">
    <% activeOrders.forEach((order) => {
      const category = order.item && order.item.category ? order.item.category.category_name : 'Uncategorized';
      const canAdvance = !['cancelled', 'order_delivered'].includes(order.status);
      const nextAction = order.status === 'preparing' ? 'order_delivered' : 'preparing';
      const nextLabel = order.status === 'preparing' ? 'Mark ready' : 'Start cooking';
      const toppings = Array.isArray(order.toppings) ? order.toppings.map((topping) => topping.name || topping).join(', ') : '';
    %>
      <article class="ticket" data-category="<%= category %>" data-created-at="<%= new Date(order.created_at).toISOString() %>">
        <div class="ticket-head">
          <div><h3>Table <%= order.table ? order.table.table_name : 'Unknown' %></h3><div class="ticket-meta">Ticket #<%= order.id %> · <%= statusLabel(order.status) %></div></div>
          <span class="elapsed" data-elapsed>0m</span>
        </div>
        <div class="ticket-lines">
          <div class="ticket-line"><strong><%= order.item ? order.item.item_name : 'Item #' + order.item_id %></strong><span>x<%= order.quantity %></span></div>
          <% if (order.variant) { %><div class="ticket-note">Option: <%= order.variant.name %></div><% } %>
          <% if (toppings) { %><div class="ticket-note">Toppings: <%= toppings %></div><% } %>
          <% if (order.remarks) { %><div class="ticket-note">Note: <%= order.remarks %></div><% } %>
        </div>
        <div class="ticket-foot">
          <div class="ticket-actions">
            <% if (canAdvance) { %><button type="button" class="order-action-btn" data-id="<%= order.id %>" data-action="<%= nextAction %>"><%= nextLabel %></button><% } %>
            <% if (order.status !== 'cancelled') { %><button type="button" class="order-action-btn secondary" data-id="<%= order.id %>" data-action="cancelled">Cancel</button><% } %>
          </div>
          <% if (order.item) { %><button type="button" class="sold-out" data-item-id="<%= order.item.id %>" aria-label="Toggle sold out for <%= order.item.item_name %>"><%= order.item.sold_out ? 'Mark available' : 'Sold out' %></button><% } %>
        </div>
      </article>
    <% }) %>
  </section>
<% } %>

<section class="card">
  <h3>Finished today (<%= finishedOrdersToday.count %>)</h3>
  <% if (!finishedOrdersToday.rows.length) { %><p class="empty-state">No finished tickets yet.</p><% } else { %>
    <% finishedOrdersToday.rows.forEach((row) => { %><div class="item-row"><span><%= row.table ? row.table.table_name : 'Unknown table' %> · <%= row.item ? row.item.item_name : 'Item #' + row.item_id %> x<%= row.quantity %></span><span><%= statusLabel(row.status) %></span></div><% }) %>
  <% } %>
</section>

<script src="/socket.io/socket.io.js"></script>
<script>
  const updateOrderBaseUrl = '<%= station === "bar" ? "/kitchen-admin" : "/kitchen-admin/kitchen" %>/update-order';
  const soldOutBaseUrl = '<%= station === "bar" ? "/kitchen-admin" : "/kitchen-admin/kitchen" %>/toggle-sold-out';
  const categoryFilter = document.getElementById('station-category');
  const tickets = [...document.querySelectorAll('.ticket')];

  function updateElapsed(ticket) {
    const createdAt = Date.parse(ticket.dataset.createdAt);
    const minutes = Math.max(0, Math.floor((Date.now() - createdAt) / 60000));
    const badge = ticket.querySelector('[data-elapsed]');
    badge.textContent = `${minutes}m`;
    ticket.classList.toggle('urgent-warn', minutes >= 5 && minutes < 12);
    ticket.classList.toggle('urgent-danger', minutes >= 12);
  }

  function applyCategoryFilter() {
    const selected = categoryFilter.value;
    tickets.forEach((ticket) => { ticket.hidden = selected !== 'all' && ticket.dataset.category !== selected; });
  }

  tickets.forEach(updateElapsed);
  setInterval(() => tickets.forEach(updateElapsed), 30000);
  if (categoryFilter) categoryFilter.addEventListener('change', applyCategoryFilter);

  document.querySelectorAll('.order-action-btn').forEach((button) => button.addEventListener('click', async () => {
    button.disabled = true;
    const response = await fetch(`${updateOrderBaseUrl}/${button.dataset.id}?action=${button.dataset.action}`);
    if (!response.ok) window.alert('The ticket could not be updated.');
    else location.reload();
  }));

  document.querySelectorAll('.sold-out').forEach((button) => button.addEventListener('click', async () => {
    button.disabled = true;
    const response = await fetch(`${soldOutBaseUrl}/${button.dataset.itemId}`, { method: 'POST' });
    if (!response.ok) window.alert('The item availability could not be updated.');
    else location.reload();
  }));

  const socket = io();
  socket.emit('join-restaurant', <%= restaurantId %>);
  socket.on('restaurant-update', () => location.reload());
</script>
